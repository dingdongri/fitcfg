"""fitcfg가 생성한 파인튜닝 스크립트.

    bash launch.sh            # 또는 README.md의 명령

설정은 아래 CONFIG 한 곳에 모여 있다. 메모리 예측은 이 설정(특히 micro_batch, seq_len,
gradient_checkpointing, deepspeed)을 전제로 하므로, 바꾸면 fitcfg로 다시 확인할 것.
학습이 끝나면 실제 peak 메모리·처리량을 fitcfg_run.json 에 남긴다 → 예측 검증/보정 데이터.
"""
import json
import os
import time
from pathlib import Path

# CUDA 할당기 단편화 줄이기 — gfarm A100(MIG) 실측: QLoRA peak 최대 1.8GB 감소, 속도 변화 없음 (2026-10-21).
# torch가 GPU 메모리를 처음 잡기 전에 설정해야 한다. 이미 지정했으면 그 값을 유지.
os.environ.setdefault("PYTORCH_CUDA_ALLOC_CONF", "expandable_segments:True")

import torch
import transformers
from datasets import load_dataset
from packaging import version
from transformers import (AutoModelForCausalLM, AutoTokenizer, DataCollatorForLanguageModeling,
                          Trainer, TrainerCallback, TrainingArguments)

# ============================== fitcfg 추천 설정 ==============================
CONFIG = __CONFIG__
# ============================================================================

HERE = Path(__file__).resolve().parent
SMOKE_MODEL = os.environ.get("FITCFG_MODEL_OVERRIDE")        # 테스트용 작은 모델 경로
MAX_STEPS = int(os.environ.get("FITCFG_MAX_STEPS", "-1"))    # 테스트/짧은 검증용
LOCAL_RANK = int(os.environ.get("LOCAL_RANK", "0"))
WORLD = int(os.environ.get("WORLD_SIZE", "1"))
ON_GPU = torch.cuda.is_available()
GiB = 1024 ** 3


def log(msg):
    if LOCAL_RANK == 0:
        print(f"[fitcfg] {msg}", flush=True)


# ------------------------------------------------------------------ 데이터
def build_dataset(tokenizer):
    """jsonl 파일(한 줄에 {"text": ...}) 또는 HF 데이터셋 이름.
    토큰을 이어붙여 seq_len 길이 블록으로 자른다(packing) → 모든 샘플 길이가 같아
    메모리 사용량이 예측과 일치하고 padding 낭비도 없다."""
    src, field, S = CONFIG["dataset"], CONFIG["text_field"], CONFIG["seq_len"]
    path = (HERE / src) if not os.path.isabs(src) else Path(src)
    if path.exists():
        ds = load_dataset("json", data_files=str(path), split="train")
    else:
        ds = load_dataset(src, split=CONFIG.get("dataset_split", "train"))

    eos = tokenizer.eos_token or ""

    def tok(batch):
        return tokenizer([t + eos for t in batch[field]], add_special_tokens=True)

    ds = ds.map(tok, batched=True, remove_columns=ds.column_names, desc="tokenize")

    def pack(batch):
        ids = sum(batch["input_ids"], [])
        n = (len(ids) // S) * S
        blocks = [ids[i:i + S] for i in range(0, n, S)]
        return {"input_ids": blocks, "attention_mask": [[1] * S for _ in blocks]}

    ds = ds.map(pack, batched=True, batch_size=1000, remove_columns=ds.column_names, desc="pack")
    if len(ds) == 0:
        raise SystemExit(f"데이터가 seq_len({S}) 한 블록보다 짧습니다. 데이터를 늘리거나 seq_len을 줄이세요.")
    log(f"학습 블록 {len(ds):,}개 × {S} 토큰 = {len(ds) * S:,} 토큰")
    return ds


# ------------------------------------------------------------------ 모델
def build_model():
    name = SMOKE_MODEL or CONFIG["model_name"]
    method, use_ds = CONFIG["method"], bool(CONFIG["deepspeed"])
    compute = {"bf16": torch.bfloat16, "fp16": torch.float16}[CONFIG["dtype"]] if ON_GPU else torch.float32
    # fp16 GPU에서 Full-FT는 fp32 가중치 + fp16 autocast(AMP)여야 GradScaler가 동작한다
    load_dtype = torch.float32 if (method == "full" and CONFIG["dtype"] == "fp16") else compute

    kw = {"attn_implementation": "sdpa"}
    kw["dtype" if version.parse(transformers.__version__) >= version.parse("4.56") else "torch_dtype"] = load_dtype
    if method == "qlora":
        from transformers import BitsAndBytesConfig
        kw["quantization_config"] = BitsAndBytesConfig(
            load_in_4bit=True, bnb_4bit_quant_type="nf4",
            bnb_4bit_compute_dtype=compute, bnb_4bit_use_double_quant=True)
    if ON_GPU and not use_ds and method in ("lora", "qlora"):
        kw["device_map"] = {"": LOCAL_RANK}          # DDP: 각 프로세스가 자기 GPU에 로드

    model = AutoModelForCausalLM.from_pretrained(name, **kw)
    model.config.use_cache = False

    if method in ("lora", "qlora"):
        from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training
        if method == "qlora":
            model = prepare_model_for_kbit_training(
                model, use_gradient_checkpointing=CONFIG["gradient_checkpointing"],
                gradient_checkpointing_kwargs={"use_reentrant": False})
        elif CONFIG["gradient_checkpointing"]:
            model.enable_input_require_grads()
        model = get_peft_model(model, LoraConfig(
            r=CONFIG["lora_rank"], lora_alpha=CONFIG["lora_alpha"],
            target_modules=CONFIG["lora_target_modules"], lora_dropout=0.05,
            bias="none", task_type="CAUSAL_LM"))
        if LOCAL_RANK == 0:
            model.print_trainable_parameters()
    return model


# ------------------------------------------------------------------ 실측 기록
class MeasureCallback(TrainerCallback):
    """실제 peak 메모리·처리량을 재서 예측과 비교하고 fitcfg_run.json 에 저장."""
    WARMUP = 3

    def __init__(self):
        self.t0 = None
        self.steps = 0

    def on_step_end(self, args, state, control, **kw):
        self.steps += 1
        if self.steps == self.WARMUP:
            if ON_GPU:
                torch.cuda.synchronize()
            self.t0, self.s0 = time.perf_counter(), state.global_step

    def on_train_end(self, args, state, control, **kw):
        if LOCAL_RANK != 0:
            return
        run = {k: CONFIG[k] for k in ("model_key", "method", "micro_batch", "grad_accum", "seq_len",
                                      "gradient_checkpointing", "optim_label", "gpus", "zero_stage",
                                      "cpu_offload_optim", "cpu_offload_params", "lora_rank",
                                      "lora_targets", "dtype")}
        run["steps"] = state.global_step
        run["transformers"] = transformers.__version__
        run["torch"] = torch.__version__
        if self.t0 is not None and state.global_step > self.s0:
            if ON_GPU:
                torch.cuda.synchronize()
            dt = time.perf_counter() - self.t0
            toks = (state.global_step - self.s0) * CONFIG["micro_batch"] * CONFIG["grad_accum"] * WORLD * CONFIG["seq_len"]
            run["tokens_per_s"] = round(toks / dt, 1)
        if ON_GPU:
            free, total = torch.cuda.mem_get_info()
            nontorch = (total - free) - torch.cuda.memory_reserved()
            run.update(gpu_name=torch.cuda.get_device_name(0),
                       peak_alloc_gb=round(torch.cuda.max_memory_allocated() / GiB, 3),
                       device_peak_gb=round((torch.cuda.max_memory_reserved() + nontorch) / GiB, 3))
        pred = CONFIG["prediction"]
        run["predicted_peak_gb"] = pred["peak_gb"]
        run["predicted_tokens_per_s"] = pred["tokens_per_s"]
        (Path(args.output_dir) / "fitcfg_run.json").write_text(json.dumps(run, indent=2, ensure_ascii=False))
        if "device_peak_gb" in run:
            err = (pred["peak_gb"] - run["device_peak_gb"]) / run["device_peak_gb"] * 100
            log(f"peak 메모리  실측 {run['device_peak_gb']:.2f}GB  vs 예측 {pred['peak_gb']:.2f}GB ({err:+.1f}%)")
        if "tokens_per_s" in run:
            log(f"처리량      실측 {run['tokens_per_s']:.0f} tok/s vs 예측 {pred['tokens_per_s']:.0f} tok/s "
                f"(범위 {pred['tokens_per_s_low']:.0f}~{pred['tokens_per_s_high']:.0f})")
        log(f"결과 저장: {Path(args.output_dir) / 'fitcfg_run.json'}")


# ------------------------------------------------------------------ main
def make_training_args(**kw):
    """transformers 버전 차이 흡수: v5에서 warmup_ratio가 사라지고 warmup_steps가 비율(float)도 받음."""
    import dataclasses
    names = {f.name for f in dataclasses.fields(TrainingArguments)}
    if "warmup_ratio" in names:
        kw["warmup_ratio"] = 0.03
    else:
        kw["warmup_steps"] = 0.03
    dropped = [k for k in kw if k not in names]
    for k in dropped:
        kw.pop(k)
    if dropped:
        log(f"이 transformers 버전에 없는 인자 무시: {dropped}")
    return TrainingArguments(**kw)


def main():
    name = SMOKE_MODEL or CONFIG["model_name"]
    tokenizer = AutoTokenizer.from_pretrained(name)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token

    # ZeRO-3는 모델 로드 전에 TrainingArguments(deepspeed=...)가 만들어져 있어야 로드 시점부터 샤딩된다
    targs = make_training_args(
        output_dir=str(HERE / CONFIG["output_dir"]),
        per_device_train_batch_size=CONFIG["micro_batch"],
        gradient_accumulation_steps=CONFIG["grad_accum"],
        num_train_epochs=CONFIG["epochs"],
        max_steps=MAX_STEPS,
        learning_rate=CONFIG["learning_rate"],
        lr_scheduler_type="cosine",
        weight_decay=0.0,
        logging_steps=10,
        save_strategy="no",
        bf16=ON_GPU and CONFIG["dtype"] == "bf16",
        fp16=ON_GPU and CONFIG["dtype"] == "fp16",
        use_cpu=not ON_GPU,
        gradient_checkpointing=CONFIG["gradient_checkpointing"],
        gradient_checkpointing_kwargs={"use_reentrant": False},
        optim=CONFIG["optim"],
        deepspeed=str(HERE / CONFIG["deepspeed"]) if CONFIG["deepspeed"] else None,
        ddp_find_unused_parameters=False if WORLD > 1 else None,
        report_to="none",
        dataloader_num_workers=2 if ON_GPU else 0,
    )
    model = build_model()
    ds = build_dataset(tokenizer)
    trainer = Trainer(model=model, args=targs, train_dataset=ds, processing_class=tokenizer,
                      data_collator=DataCollatorForLanguageModeling(tokenizer, mlm=False),
                      callbacks=[MeasureCallback()])
    trainer.train()
    if CONFIG["save_model"]:
        trainer.save_model(targs.output_dir)      # LoRA면 어댑터만 저장
        log(f"모델 저장: {targs.output_dir}")


if __name__ == "__main__":
    main()
